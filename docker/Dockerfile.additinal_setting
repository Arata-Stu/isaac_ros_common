# ============================================================
# ベース: ISAAC ROS 基本イメージ
# ============================================================
ARG BASE_IMAGE
FROM ${BASE_IMAGE}

# ============================================================
# root 権限に切り替え
# ============================================================
USER root
SHELL ["/bin/bash", "-c"]

# ============================================================
# 1. 必須ツールのインストール
# ============================================================
RUN apt-get update && \
    apt-get install -y \
        tmux \
        iproute2 \
        terminator \
        vim \
        htop \
        can-utils \
        bluez \
        joystick \
        git \
    && \
    rm -rf /var/lib/apt/lists/*

# ============================================================
# 2. CycloneDDS 設定
# ============================================================
COPY middleware_profiles/cyclonedds.xml /etc/cyclonedds.xml
ENV RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
ENV CYCLONEDDS_URI=file:///etc/cyclonedds.xml
ENV ROS_DOMAIN_ID=33

# ============================================================
# 3. ISAAC ROS 関連パッケージのインストール
# ============================================================
RUN apt-get update && \
    apt-get install -y \
        ros-humble-ackermann-msgs \
        ros-humble-isaac-ros-examples \
        ros-humble-isaac-ros-realsense \
        ros-humble-isaac-ros-h264-decoder \
        ros-humble-isaac-ros-launch-utils \
        ros-humble-isaac-ros-test \
        ros-humble-isaac-ros-visual-slam-interfaces \
        ros-humble-gxf-isaac-image-flip \
        ros-humble-gxf-isaac-tensorops \
        ros-humble-isaac-ros-image-proc \
        ros-humble-isaac-ros-nitros-compressed-image-type \
        ros-humble-isaac-ros-tensor-rt \
        ros-humble-isaac-ros-dnn-image-encoder \
        ros-humble-isaac-ros-triton \
        ros-humble-isaac-ros-visual-slam \
        ros-humble-rqt-robot-monitor \
        ros-humble-isaac-ros-jetson-stats \
        ros-humble-rtabmap-ros \
        ros-humble-isaac-mapping-ros \
        ros-humble-isaac-ros-apriltag-interfaces \
    && \
    rm -rf /var/lib/apt/lists/*

# ============================================================
# 4. Jetracer ライブラリのインストール
# ============================================================
RUN set -x && \
    cd /tmp && \
    git clone https://github.com/NVIDIA-AI-IOT/jetracer.git && \
    cd jetracer && \
    python3 setup.py install && \
    pip3 install traitlets questionary jetson-gpio && \
    cd / && rm -rf /tmp/*


# ============================================================
# 5. PyTorch と torchvision のインストール
# ============================================================
RUN pip install torch==2.8.0 torchvision==0.23.0

# ============================================================
# 6. スクリプト類を配置
# ============================================================
COPY scripts/entrypoint_additions/*.sh /usr/local/bin/scripts/entrypoint_additions/
RUN chmod +x /usr/local/bin/scripts/entrypoint_additions/*.sh || true

# ============================================================
# 7. admin ユーザーの設定
# ============================================================
ARG HOST_USER_UID=1000
ARG HOST_USER_GID=1000
RUN groupadd -f -g $HOST_USER_GID admin && \
    useradd -o -u $HOST_USER_UID -g $HOST_USER_GID -m -s /bin/bash admin && \
    echo "admin ALL=(ALL) NOPASSWD: ALL" >> /etc/sudoers.d/admin-nopasswd

# ============================================================
# 8. 作業ディレクトリ設定
# ============================================================
WORKDIR /workspaces